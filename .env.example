# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Required API keys ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Gemini models (free-tier Flash models; verified at startup) ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.2

# --- Free-tier quota protection ---
# Client-side throttle for Gemini calls (requests per minute)
GEMINI_MAX_RPM=8
# Critic -> Reviser loop limit (each revision costs 2 LLM calls)
MAX_REVISIONS=1
# Max tool-calling rounds for the web research agent
MAX_RESEARCH_TOOL_ROUNDS=2
TAVILY_MAX_RESULTS=5
# basic = 1 Tavily credit per search, advanced = 2
TAVILY_SEARCH_DEPTH=basic
RAG_TOP_K=4

# --- Knowledge base / RAG ---
# Embedding vector size (gemini-embedding-001 supports 128-3072). Changing it
# requires re-processing documents, since Chroma vectors must share one size.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RPM=30
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Cosine relevance cut-off: Gemini embeddings score unrelated text ~0.45-0.55
RAG_MIN_RELEVANCE=0.6
MAX_UPLOAD_MB=20

# --- Storage ---
DATABASE_URL=sqlite:///data/researchpilot.db
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
REPORTS_DIR=reports

# --- Services ---
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
